# =============================================================================
# Agents Anywhere · 自托管部署配置模板
#
# 用法（在 N100 上）：
#   ./docker/selfhost/aa.sh init --domain aa.example.com
#     → 自动生成随机密钥、探测 Tailscale IP，产出 docker/selfhost/.env
#   然后：
#   ./docker/selfhost/aa.sh up
#
# 也可以手工来：
#   cp docker/selfhost/.env.example docker/selfhost/.env && chmod 600 docker/selfhost/.env
#   再按下面的注释逐项填写。
#
# 注意：
#   1. 本文件被 docker compose 用作 "变量插值源"，同时也是容器的环境来源。
#      仓库根 .gitignore 不忽略 .env，所以同目录另放了 .gitignore 兜底，
#      不要把填好的 .env 提交到 Git。
#   2. 值里如果需要写美元符号，必须写成 $$（Compose 的转义规则）。
#   3. 密码请只使用字母和数字（例如 openssl rand -hex 24）。含 @ : / 等
#      字符会破坏下面拼接出来的数据库连接串。
# =============================================================================

# -----------------------------------------------------------------------------
# 必填
# -----------------------------------------------------------------------------

# PostgreSQL 密码。同时用于数据库容器和 Server 的连接串。
POSTGRES_PASSWORD=

# 会话 / 令牌签名密钥。必须替换，绝不能沿用默认值。
#   生成：openssl rand -hex 32
AGENT_SERVER_SECRET=

# -----------------------------------------------------------------------------
# 对外地址（必填）
# -----------------------------------------------------------------------------

# 用户和桌面客户端实际访问的地址，也就是阿里云 Nginx 上那个 HTTPS 域名。
# 末尾不要带斜杠。Server 用它拼接分享链接和 OAuth 回调地址。
# 故意留空：填错域名不会报错，只会让分享链接和 OAuth 回调指向错误的主机，
# 所以这里要求你显式写死。例如 https://aa.example.com
AGENT_SERVER_PUBLIC_ORIGIN=

# 允许的跨域来源，逗号分隔。留空则默认跟随 AGENT_SERVER_PUBLIC_ORIGIN。
# 同源部署下浏览器不会触发跨域，显式填上可以避免将来分离部署时踩坑。
AGENT_SERVER_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# N100 上的监听设置（必填）
# -----------------------------------------------------------------------------

# Web 端口绑定到哪个地址。
#   - 填 N100 的 Tailscale IP（tailscale ip -4 的输出，形如 100.x.y.z）：
#     只有 tailnet 内的阿里云 Nginx 能访问，5174 不会暴露给局域网和公网。
#     这是本项目推荐的配置。
#   - 填 127.0.0.1：最严格，但阿里云 Nginx 就无法直连，需要额外的隧道转发。
AGENTS_ANYWHERE_BIND_ADDR=

# Web 对外端口（宿主侧）。容器内固定监听 8000。
AGENTS_ANYWHERE_WEB_PORT=5174

# -----------------------------------------------------------------------------
# 首次管理员 bootstrap
# -----------------------------------------------------------------------------

# setup token 有效期（秒）。默认 900（15 分钟）。过期后服务会自动重新生成
# 并再次打印到 server-next 日志，刷新页面即可。
# 首次部署时如果一时找不到 token，可以临时调大，例如 3600。
AGENT_SERVER_SETUP_TOKEN_TTL=900

# -----------------------------------------------------------------------------
# 可选：并发与资源（N100 是 4 核低功耗平台，默认值即为推荐值）
# -----------------------------------------------------------------------------

# Uvicorn worker 数。必须为 1，除非同时配置了 Redis 且已读过性能文档。
AGENT_SERVER_WORKERS=1
# 每个 worker 的事件预处理子进程数。0 表示在主进程内处理。
AGENT_SERVER_EVENT_WORKERS=2

AGENT_SERVER_DB_POOL_SIZE=10
AGENT_SERVER_DB_MAX_OVERFLOW=20
AGENT_SERVER_DB_POOL_TIMEOUT=30
AGENT_SERVER_DB_POOL_RECYCLE=1800

# Redis 内存上限。Redis 用 noeviction + AOF，调太小会在高负载下写失败。
REDIS_MAXMEMORY=256mb

# Timeline 版本号租约大小。除非排障，不要改。
AGENT_SERVER_TIMELINE_REVISION_LEASE_SIZE=4096

# 数据库迁移时的建议锁等待上限（秒）。
AGENT_SERVER_MIGRATION_LOCK_TIMEOUT=120

# -----------------------------------------------------------------------------
# 容器资源上限
#
# 本机实测：15Gi 总量 / 9.2Gi available，但 swap 975Mi 已 100% 用满。
# swap 见底意味着没有缓冲，超额就会触发 OOM killer，被杀的多半是 Jellyfin /
# Emby / Supabase 这些老住户。所以这里刻意给得保守，合计 4.5 GiB 上限。
#
# 跑满一天后按 docker stats 的实际值再放宽：
#   docker stats --no-stream --format 'table {{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}'
# -----------------------------------------------------------------------------

POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=512m
SERVER_MEM_LIMIT=3g
SERVER_CPUS=3.0

# -----------------------------------------------------------------------------
# 可选：把上传文件放到 S3 兼容对象存储，而不是 N100 本地卷
# 留空则使用本地卷 agents-anywhere-files-next（挂载在 /data）。
# -----------------------------------------------------------------------------
# AGENT_SERVER_FILES_BACKEND=s3
# AGENT_SERVER_FILES_S3_BUCKET=
# AGENT_SERVER_FILES_S3_PREFIX=
# AGENT_SERVER_FILES_S3_ACCESS_KEY=
# AGENT_SERVER_FILES_S3_SECRET_KEY=
# AGENT_SERVER_FILES_S3_REGION=
# AGENT_SERVER_FILES_S3_ENDPOINT_URL=
# AGENT_SERVER_FILES_S3_VIRTUAL_HOST_STYLE=true
