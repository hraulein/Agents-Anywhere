# 复制到 agents-anywhere-v2/v2.env，并把两个值换成随机串。
# 注意：Compose 会对 env_file 做变量插值，值里不要出现 $。
POSTGRES_PASSWORD=replace-with-a-random-password

AGENT_SERVER_DB_URL=postgresql+asyncpg://agents_anywhere:replace-with-a-random-password@aa-v2-postgres:5432/agents_anywhere
AGENT_SERVER_REDIS_URL=redis://aa-v2-redis:6379/0
AGENT_SERVER_SECRET=replace-with-a-random-string-of-at-least-32-chars
AGENT_SERVER_FILES_BACKEND=local
AGENT_SERVER_FILES_LOCAL_ROOT=/data/agent-server.files
AGENT_SERVER_PUBLIC_ORIGIN=
AGENT_SERVER_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
